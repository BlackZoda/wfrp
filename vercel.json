{
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "devCommand": "npm run start",
    "routes": [
      {
        "src": "/(.*)",
        "has": [
          {
            "type": "header",
            "key": "X-Processed-By",
            "value": "edge-function"
          }
        ],
        "dest": "/$1"
      },
      {
        "src": "/(.*)",
        "dest": "/api/edge"
      }
    ]
}