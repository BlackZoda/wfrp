{
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "devCommand": "npm run start",
    "routes": [
      {
        "src": "/(.*)",
        "has": [
          {
            "type": "cookie",
            "key": "sessionId",
            "value": "(?<sessionId>.*)"
          }
        ],
        "dest": "/$1"
      },
      {
        "src": "/(.*)",
        "dest": "/api/edge"
      }
  ]
}