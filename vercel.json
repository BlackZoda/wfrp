{
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "devCommand": "npm run start",
    "routes": [
      { "src": "/api/edge", "dest": "/api/edge" },
      { "src": "/(.*)", "dest": "/api/edge" },
      { "handle": "filesystem" },
      { "src": "/(.*)", "dest": "/404" }
    ]
}