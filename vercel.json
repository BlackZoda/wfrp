{
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "devCommand": "npm run start",
    "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/logout", "dest": "/api/edge" },
    { "src": "/protected/(.*)", "dest": "/api/edge" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404" }
  ]
}